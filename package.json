{
  "name": "jumpman",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Super Mario 64 controller and physics ported to Three.js",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && node scripts/build-offline.mjs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "export:courses": "python3 scripts/export-courses.py",
    "export:assets": "python3 scripts/export-sm64.py",
    "check:assets": "python3 scripts/check-sm64-library.py",
    "deploy": "node scripts/check-deploy-assets.mjs && pnpm build && wrangler deploy",
    "worker:dev": "wrangler dev",
    "export:audio": "python3 scripts/export-audio.py"
  },
  "dependencies": {
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/three": "^0.187.0",
    "puppeteer-core": "^25.16.0",
    "typescript": "~5.9.3",
    "vite": "^7.3.7",
    "vitest": "^3.2.7",
    "wrangler": "^4.155.0"
  },
  "engines": {
    "node": ">=20.19"
  }
}
